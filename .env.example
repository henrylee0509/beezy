# Meta Model API — get a key from the Model API dashboard (API keys -> Create API key).
# Leave empty to run in clearly-labelled MOCK mode.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
# Optional: "low" speeds up agent turns; leave empty for the API default.
META_REASONING_EFFORT=
META_TIMEOUT_SEC=90

# auto = real when MODEL_API_KEY is set, otherwise mock. Force with "real" or "mock".
BP_AI_MODE=auto

# Where the SQLite database and uploads live (default ./data)
# BP_DATA_DIR=./data
# Optional fixed signing secret (otherwise one is generated into data/.jwt_secret)
# BP_JWT_SECRET=
# Background automation interval in seconds (0 disables the scheduler)
BP_AUTOMATION_INTERVAL_SEC=900
PORT=8000
